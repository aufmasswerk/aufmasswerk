QMainWindow,QWidget{background:#0b0c10;color:#f2efff;font-size:13px;font-family:"Inter","Noto Sans","DejaVu Sans",sans-serif}
QScrollArea,QScrollArea>QWidget>QWidget{background:#0b0c10;border:none}
#nav{background:#111118;color:#f2efff;border:none;font-size:14px;padding:14px 10px}
#nav::item{padding:13px 11px;margin:3px 0;border-radius:8px}
#nav::item:hover{background:#252039;color:#ffffff}
#nav::item:selected{background:#32164d;color:#ff55df;font-weight:600;border-left:3px solid #ff2bd6}
#pageTitle{font-size:26px;font-weight:700;color:#ff55df;padding:3px 0 7px 0}
#paymentStat{font-size:14px;padding:11px 15px;background:#15151c;border:1px solid #383044;border-radius:11px}
#dashboardCard{border:1px solid #383044;border-radius:13px;background:#15151c;margin-top:14px;padding:20px 12px 12px 12px}
#dashboardCard::title{color:#d9d2e6;background:#15151c}
#dashboardValue{font-size:22px;font-weight:700;color:#ff2bd6;padding:16px 8px;background:#15151c}
QGroupBox{font-weight:600;border:1px solid #383044;border-radius:10px;margin-top:16px;padding:18px 10px 10px 10px;background:#15151c}
QGroupBox::title{subcontrol-origin:margin;subcontrol-position:top left;left:12px;padding:0 7px;background:#15151c;color:#e9e3f2}
QPushButton{min-height:20px;padding:2px 12px;background:#1c1b25;border:1px solid #4b405b;border-radius:6px;color:#f4f0ff}
QPushButton:hover{background:#35204d;border-color:#ff2bd6;color:#ffffff}
QPushButton:pressed{background:#54156d;border-color:#ff55df}
QPushButton:disabled{background:#111217;color:#716b7d;border-color:#2a2630}
QToolButton{background:#1c1b25;border:1px solid #4b405b;border-radius:5px;padding:2px}
QToolButton:hover{background:#35204d;border-color:#ff2bd6}
QToolButton:pressed{background:#54156d;border-color:#ff55df}
QToolButton:disabled{background:#111217;border-color:#2a2630}
QLineEdit,QTextEdit,QComboBox,QDoubleSpinBox,QSpinBox,QDateEdit{padding:7px 9px;background:#12131a;color:#f4f0ff;border:1px solid #4c4259;border-radius:6px;selection-background-color:#8c1ba8;selection-color:#ffffff}
QLineEdit:focus,QTextEdit:focus,QComboBox:focus,QDoubleSpinBox:focus,QSpinBox:focus,QDateEdit:focus{border:1px solid #ff2bd6}
QComboBox QAbstractItemView{background:#181720;color:#f4f0ff;border:1px solid #4b405b;selection-background-color:#6f168b}
QTableWidget{background:#13141a;alternate-background-color:#181921;color:#ede9f7;gridline-color:#302b39;border:1px solid #3b3445;border-radius:7px;selection-background-color:#68157f;selection-color:#ffffff}
QTableWidget::item{padding:7px 8px;border:none}
QTableWidget::item:hover{background:#292037}
QHeaderView::section{background:#1d1b26;color:#f0ebfa;padding:5px 8px;font-weight:600;border:none;border-right:1px solid #40364d;border-bottom:1px solid #40364d}
QTableCornerButton::section{background:#1d1b26;border:1px solid #40364d}
QSplitter::handle{background:#38313f;width:6px}
QScrollBar:vertical{background:#0f1015;width:12px;margin:0}
QScrollBar::handle:vertical{background:#4d405c;min-height:28px;border-radius:5px}
QScrollBar:horizontal{background:#0f1015;height:12px;margin:0}
QScrollBar::handle:horizontal{background:#4d405c;min-width:28px;border-radius:5px}
QScrollBar::add-line,QScrollBar::sub-line{width:0;height:0}
QStatusBar{background:#111217;color:#c7bfD3;border-top:1px solid #302938}
QToolTip{background:#201927;color:#ffffff;border:1px solid #ff2bd6;padding:5px}

#columnLockButton{padding:0;border-radius:0;min-height:0}
QFrame#formulaInlineEditor,QFrame#serviceInlineEditor,QFrame#offerFormulaInlineEditor{background:#181720;border:1px solid #533b65;border-radius:5px}
QLabel#formulaResult,QLabel#offerFormulaResult{font-size:14px;font-weight:600}
QFrame#topNavigation,QFrame#contextSidebar{background:#111217;border-color:#302938} QFrame#topNavigation{border-bottom:1px solid #302938} QFrame#contextSidebar{border-right:1px solid #302938}
QLabel#topBrand,QLabel#contextTitle,QLabel#workspaceEyebrow{color:#ff2bd6;font-weight:700} QLabel#topBrand,QLabel#contextTitle{font-size:17px}
QToolButton#topNavButton{min-height:30px;padding:4px 8px;border:1px solid transparent;border-radius:6px;background:transparent} QToolButton#topNavButton:hover,QToolButton#topNavButton:checked{background:#2b2033;border-color:#ff2bd6}
QListWidget#contextProjects{background:#101116;border:1px solid #3e3149;border-radius:7px;padding:4px} QListWidget#contextProjects::item{padding:9px 7px;margin:2px;border-radius:6px} QListWidget#contextProjects::item:selected{background:#38233f;border-left:3px solid #ff2bd6}
QFrame#workspaceInfo{background:#181720;border:1px solid #3e3149;border-radius:10px} QPushButton#workspaceCard{text-align:left;min-height:92px;padding:12px 16px;font-size:14px}
