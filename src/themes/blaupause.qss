/* Tageslicht / Blaupause - High Contrast Light Theme */

/* 1. Grundgerüst: Maximaler Kontrast für helle Umgebungen */
* {
    background-color: #ffffff;
    color: #111111;
    font-size: 14px;
    font-family: sans-serif;
}

/* 2. Top-Navigation und Menüs */
#topNavigation, QMenuBar, QToolBar {
background-color: #f0f2f5;
border-bottom: 3px solid #005bb5; /* Kräftiges Blaupause-Blau als Anker */
padding: 5px;
}

/* 3. Tabellen & Eingabefelder (Aufmaß, Rechnungen) */
QTableWidget, QLineEdit, QComboBox, input, table {
    background-color: #ffffff;
    border: 1px solid #94a3b8; /* Klar definierte Kanten */
    border-radius: 3px;
    padding: 4px;
    color: #111111;
    gridline-color: #cbd5e1; /* Deutliche Gitterlinien für die Tabellen-Matrix */
}

/* Header der Tabelle (Spaltenköpfe) */
QHeaderView::section {
    background-color: #e2e8f0;
    color: #0f172a;
    font-weight: bold;
    border: 1px solid #94a3b8;
    padding: 4px;
}

/* 4. Primäre Aktionen: Signalwirkung */
QPushButton, button {
    background-color: #f8fafc;
    border: 2px solid #005bb5;
    color: #005bb5;
    border-radius: 4px;
    padding: 2px 12px;
    font-weight: bold;
}

/* Hover-Effekt: Blau füllt sich massiv aus, perfekt für ungenaues Klicken draußen */
QPushButton:hover, button:hover {
    background-color: #005bb5;
    color: #ffffff;
}

QToolButton {
    background-color: #f8fafc;
    border: 2px solid #005bb5;
    border-radius: 4px;
    padding: 2px;
}

QToolButton:hover {
    background-color: #cbdff2;
}

QToolButton:pressed {
    background-color: #a9c9e8;
}

QPushButton:pressed, button:pressed {
    background-color: #003f7d;
    color: #ffffff;
}
